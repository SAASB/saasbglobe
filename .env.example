# Database
DATABASE_URL=postgresql://user:password@localhost:5432/saasb_track
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# API
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=30d

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@saas-b-track.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=saasb-track-bucket

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Frontend
REACT_APP_API_URL=http://localhost:3000
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your_session_secret
SESSION_EXPIRY=24h

# Data Retention
ACTIVITY_RETENTION_DAYS=90
LOCATION_RETENTION_DAYS=180

# Geofencing
GEOFENCE_CHECK_INTERVAL=30000

# Notifications
PUSH_NOTIFICATION_SERVICE=fcm
FCM_SERVER_KEY=your_fcm_server_key